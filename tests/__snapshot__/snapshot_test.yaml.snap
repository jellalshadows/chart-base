        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-env
  2: |
    apiVersion: v1
    data:
      migrations.yaml: 'target: latest'
    kind: ConfigMap
    metadata:
      annotations:
        helm.sh/hook: pre-install,pre-upgrade
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
        helm.sh/hook-weight: "-10"
      labels:
        app.kubernetes.io/component: job
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-files
  3: |
    apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      annotations:
        helm.sh/hook: pre-install,pre-upgrade
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
        helm.sh/hook-weight: "-10"
      labels:
        app.kubernetes.io/component: job
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-secrets
    spec:
      data:
        - remoteRef:
            key: /sales/db-password
          secretKey: DB_PASSWORD
      refreshInterval: 1h
      secretStoreRef:
        kind: ClusterSecretStore
        name: fake
      target:
        creationPolicy: Owner
        name: vending-chart-base-secrets
  4: |
    apiVersion: batch/v1
    kind: Job
    metadata:
      annotations:
        helm.sh/hook: pre-install,pre-upgrade
        helm.sh/hook-delete-policy: before-hook-creation
        helm.sh/hook-weight: "0"
      labels:
        app.kubernetes.io/component: job
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      activeDeadlineSeconds: 120
      backoffLimit: 0
      template:
        metadata:
          labels:
            app.kubernetes.io/component: job
            app.kubernetes.io/instance: vending
            app.kubernetes.io/name: chart-base
            app.kubernetes.io/part-of: vending
            app.kubernetes.io/version: 2.66.1
        spec:
          automountServiceAccountToken: false
          containers:
            - command:
                - sh
                - -c
                - /agnhost connect 127.0.0.1:8081 --timeout=2s && test "$APP_MODE" = migrate && test "$DB_PASSWORD" = s3cr3t && test -f /config/migrations.yaml && echo migrations-ok
              envFrom:
                - configMapRef:
                    name: vending-chart-base-env
                - secretRef:
                    name: vending-chart-base-secrets
              image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
              imagePullPolicy: IfNotPresent
              name: chart-base
              resources:
                requests:
                  cpu: 10m
                  memory: 16Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /config
                  name: config-files
                  readOnly: true
          enableServiceLinks: false
          initContainers:
            - args:
                - netexec
                - --http-port=8081
                - --udp-port=-1
              image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
              imagePullPolicy: IfNotPresent
              name: side
              ports:
                - containerPort: 8081
                  name: side
                  protocol: TCP
              resources:
                requests:
                  cpu: 10m
                  memory: 16Mi
              restartPolicy: Always
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
              startupProbe:
                failureThreshold: 30
                periodSeconds: 1
                tcpSocket:
                  port: side
          restartPolicy: Never
          securityContext:
            fsGroup: 65532
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 65532
            runAsNonRoot: true
            runAsUser: 65532
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: vending-chart-base
          terminationGracePeriodSeconds: 30
          volumes:
            - emptyDir: {}
              name: tmp
            - configMap:
                name: vending-chart-base-files
              name: config-files
      ttlSecondsAfterFinished: 3600
  5: |
    apiVersion: v1
    automountServiceAccountToken: false
    kind: ServiceAccount
    metadata:
      annotations:
        helm.sh/hook: pre-install,pre-upgrade
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
        helm.sh/hook-weight: "-10"
      labels:
        app.kubernetes.io/component: job
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
