cronjob scenario:
  1: |
    apiVersion: v1
    data:
      APP_MODE: cleanup
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: cronjob
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-env
  2: |
    apiVersion: batch/v1
    kind: CronJob
    metadata:
      labels:
        app.kubernetes.io/component: cronjob
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      concurrencyPolicy: Forbid
      failedJobsHistoryLimit: 1
      jobTemplate:
        metadata:
          labels:
            app.kubernetes.io/component: cronjob
            app.kubernetes.io/instance: vending
            app.kubernetes.io/name: chart-base
            app.kubernetes.io/part-of: vending
            app.kubernetes.io/version: 2.66.1
        spec:
          backoffLimit: 3
          template:
            metadata:
              labels:
                app.kubernetes.io/component: cronjob
                app.kubernetes.io/instance: vending
                app.kubernetes.io/name: chart-base
                app.kubernetes.io/part-of: vending
                app.kubernetes.io/version: 2.66.1
            spec:
              automountServiceAccountToken: false
              containers:
                - command:
                    - sh
                    - -c
                    - test "$APP_MODE" = cleanup && test -n "$POD_NAME" && test "$MEMORY_MB" = 64 && test "$SHARED_TOKEN" = abc && test -n "$KUBERNETES_SERVICE_HOST" && test -z "$DEPLOYMENT_CHART_BASE_SERVICE_HOST" && echo ok && echo "$POD_NAME" > /work/pod && test ! -e /scratch/marker && touch /scratch/marker && echo "$POD_NAME" >> /runs/pods.log && cat /runs/pods.log
                  env:
                    - name: MEMORY_MB
                      valueFrom:
                        resourceFieldRef:
                          divisor: 1Mi
                          resource: limits.memory
                    - name: POD_NAME
                      valueFrom:
                        fieldRef:
                          fieldPath: metadata.name
                  envFrom:
                    - prefix: SHARED_
                      secretRef:
                        name: e2e-shared
                    - configMapRef:
                        name: vending-chart-base-env
                  image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
                  imagePullPolicy: IfNotPresent
                  name: chart-base
                  resources:
                    limits:
                      memory: 64Mi
                    requests:
                      cpu: 10m
                      memory: 16Mi
                  securityContext:
                    allowPrivilegeEscalation: false
                    capabilities:
                      drop:
                        - ALL
                    readOnlyRootFilesystem: true
                    runAsNonRoot: true
                  volumeMounts:
                    - mountPath: /tmp
                      name: tmp
                    - mountPath: /runs
                      name: runs
                    - mountPath: /scratch
                      name: scratch
                    - mountPath: /work
                      name: work
              enableServiceLinks: false
              restartPolicy: Never
              securityContext:
                fsGroup: 65532
                fsGroupChangePolicy: OnRootMismatch
                runAsGroup: 65532
                runAsNonRoot: true
                runAsUser: 65532
                seccompProfile:
                  type: RuntimeDefault
              serviceAccountName: vending-chart-base
              terminationGracePeriodSeconds: 30
              volumes:
                - emptyDir: {}
                  name: tmp
                - name: runs
                  persistentVolumeClaim:
                    claimName: e2e-runs
                - ephemeral:
                    volumeClaimTemplate:
                      metadata:
                        labels:
                          app.kubernetes.io/instance: vending
                          app.kubernetes.io/name: chart-base
                      spec:
                        accessModes:
                          - ReadWriteOnce
                        resources:
                          requests:
                            storage: 64Mi
                  name: scratch
                - emptyDir: {}
                  name: work
      schedule: '*/30 * * * *'
      successfulJobsHistoryLimit: 3
      suspend: false
      timeZone: Europe/Madrid
  3: |
    apiVersion: v1
    automountServiceAccountToken: false
    kind: ServiceAccount
    metadata:
      labels:
        app.kubernetes.io/component: cronjob
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
deployment scenario:
  1: |
    apiVersion: v1
    data:
      APP_MODE: api
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-env
  2: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      progressDeadlineSeconds: 240
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: vending
          app.kubernetes.io/name: chart-base
      template:
        metadata:
          annotations:
            checksum/config-env: 75b7a7c324b7b1ceeee7b8e259bbac68dc693ec9adf80945c927b2a1116c4ebb
          labels:
            app.kubernetes.io/component: deployment
            app.kubernetes.io/instance: vending
            app.kubernetes.io/name: chart-base
            app.kubernetes.io/part-of: vending
            app.kubernetes.io/version: 2.66.1
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - netexec
                - --http-port=8080
              envFrom:
                - configMapRef:
                    name: vending-chart-base-env
              image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
              imagePullPolicy: IfNotPresent
              lifecycle:
                preStop:
                  sleep:
                    seconds: 5
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: http
              name: chart-base
              ports:
                - containerPort: 8080
                  name: http
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /healthz
                  port: http
              resources:
                limits:
                  memory: 64Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /work
                  name: work
                  readOnly: true
          enableServiceLinks: false
          initContainers:
            - command:
                - sh
                - -c
                - echo init-ok > /work/marker
              image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
              imagePullPolicy: IfNotPresent
              name: setup
              resources:
                requests:
                  cpu: 10m
                  memory: 16Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
              volumeMounts:
                - mountPath: /work
                  name: work
            - args:
                - netexec
                - --http-port=8081
                - --udp-port=-1
              image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
              imagePullPolicy: IfNotPresent
              name: side
              ports:
                - containerPort: 8081
                  name: side
                  protocol: TCP
              resources:
                requests:
                  cpu: 10m
                  memory: 16Mi
              restartPolicy: Always
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
              startupProbe:
                failureThreshold: 30
                periodSeconds: 1
                tcpSocket:
                  port: side
            - args:
                - connect
                - 127.0.0.1:8081
                - --timeout=2s
              image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
              imagePullPolicy: IfNotPresent
              name: wait-side
              resources:
                requests:
                  cpu: 10m
                  memory: 16Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
          securityContext:
            fsGroup: 65532
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 65532
            runAsNonRoot: true
            runAsUser: 65532
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: vending-chart-base
          terminationGracePeriodSeconds: 30
          topologySpreadConstraints:
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: vending
                  app.kubernetes.io/name: chart-base
              matchLabelKeys:
                - pod-template-hash
              maxSkew: 1
              topologyKey: topology.kubernetes.io/zone
              whenUnsatisfiable: ScheduleAnyway
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: vending
                  app.kubernetes.io/name: chart-base
              matchLabelKeys:
                - pod-template-hash
              maxSkew: 1
              topologyKey: kubernetes.io/hostname
              whenUnsatisfiable: ScheduleAnyway
          volumes:
            - emptyDir: {}
              name: tmp
            - emptyDir: {}
              name: work
  3: |
    apiVersion: policy/v1
    kind: PodDisruptionBudget
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      maxUnavailable: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: vending
          app.kubernetes.io/name: chart-base
      unhealthyPodEvictionPolicy: AlwaysAllow
  4: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      ports:
        - name: http
          port: 8080
          protocol: TCP
          targetPort: http
      selector:
        app.kubernetes.io/instance: vending
        app.kubernetes.io/name: chart-base
      type: ClusterIP
  5: |
    apiVersion: v1
    automountServiceAccountToken: false
    kind: ServiceAccount
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
full scenario:
  1: |
    apiVersion: v1
    data:
      APP_MODE: api
      FEATURE_FLAG: "true"
      MAX_POOL: "20"
      SPRING_CONFIG_ADDITIONAL_LOCATION: optional:file:/config/
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-env
  2: |
    apiVersion: v1
    data:
      application.yaml: |-
        spring:
          datasource:
            password: ${DB_PASSWORD}
            url: jdbc:postgresql://db:5432/sales
      logback-spring.xml: |
        <configuration>
          <root level="INFO"/>
        </configuration>
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-files
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      annotations:
        configmap.reloader.stakater.com/reload: e2e-rules
        secret.reloader.stakater.com/reload: e2e-files,e2e-shared,vending-chart-base-secrets
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      minReadySeconds: 5
      progressDeadlineSeconds: 240
      revisionHistoryLimit: 5
      selector:
        matchLabels:
          app.kubernetes.io/instance: vending
          app.kubernetes.io/name: chart-base
      strategy:
        rollingUpdate:
          maxSurge: 1
          maxUnavailable: 0
        type: RollingUpdate
      template:
        metadata:
          annotations:
            checksum/config-env: 5bb45ae36a56ebe7a1525d036a5ba7c400189b0dcd20fed1f777f87e5282fc14
            checksum/config-files: 2f54280aa10f85462610e938e4985cf3194df1c9ffb8ffaea4b1c70fa074f796
            example.com/team: vending
          labels:
            app.kubernetes.io/component: deployment
            app.kubernetes.io/instance: vending
            app.kubernetes.io/name: chart-base
            app.kubernetes.io/part-of: vending
            app.kubernetes.io/version: 2.66.1
            example.com/tier: backend
        spec:
          automountServiceAccountToken: true
          containers:
            - args:
                - netexec
                - --http-port=8080
              env:
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: SHARED_TOKEN
                  valueFrom:
                    secretKeyRef:
                      key: TOKEN
                      name: e2e-shared
              envFrom:
                - configMapRef:
                    name: vending-chart-base-env
                - secretRef:
                    name: vending-chart-base-secrets
              image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
              imagePullPolicy: IfNotPresent
              lifecycle:
                preStop:
                  sleep:
                    seconds: 5
              name: chart-base
              ports:
                - containerPort: 8080
                  name: http
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /healthz
                  port: http
              resources:
                limits:
                  memory: 64Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
              startupProbe:
                failureThreshold: 30
                httpGet:
                  path: /healthz
                  port: http
                periodSeconds: 2
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /config
                  name: config-files
                  readOnly: true
                - mountPath: /tmp/cache
                  name: cache
                - mountPath: /config/secrets
                  name: files
                  readOnly: true
                - mountPath: /etc/rules/alerts.yaml
                  name: rules
                  readOnly: true
                  subPath: alerts.yaml
          dnsConfig:
            options:
              - name: ndots
                value: "2"
          enableServiceLinks: false
          hostAliases:
            - hostnames:
                - legacy-db.internal
              ip: 10.20.30.40
          initContainers:
            - args:
                - pause
              image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
              imagePullPolicy: IfNotPresent
              name: shipper
              resources:
                requests:
                  cpu: 10m
                  memory: 16Mi
              restartPolicy: Always
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
          priorityClassName: e2e-high
          securityContext:
            fsGroup: 65532
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 65532
            runAsNonRoot: true
            runAsUser: 65532
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: vending-chart-base
          terminationGracePeriodSeconds: 30
          topologySpreadConstraints:
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: vending
                  app.kubernetes.io/name: chart-base
              matchLabelKeys:
                - pod-template-hash
              maxSkew: 1
              topologyKey: topology.kubernetes.io/zone
              whenUnsatisfiable: ScheduleAnyway
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: vending
                  app.kubernetes.io/name: chart-base
              matchLabelKeys:
                - pod-template-hash
              maxSkew: 1
              topologyKey: kubernetes.io/hostname
              whenUnsatisfiable: ScheduleAnyway
          volumes:
            - emptyDir: {}
              name: tmp
            - configMap:
                name: vending-chart-base-files
              name: config-files
            - emptyDir:
                medium: Memory
                sizeLimit: 16Mi
              name: cache
            - name: files
              secret:
                secretName: e2e-files
            - configMap:
                defaultMode: 288
                items:
                  - key: alerts
                    mode: 292
                    path: alerts.yaml
                name: e2e-rules
                optional: false
              name: rules
  4: |
    apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-secrets
    spec:
      data:
        - remoteRef:
            key: /sales/db-password
          secretKey: DB_PASSWORD
      refreshInterval: 1h
      secretStoreRef:
        kind: ClusterSecretStore
        name: fake
      target:
        creationPolicy: Owner
        name: vending-chart-base-secrets
  5: |
    apiVersion: autoscaling/v2
    kind: HorizontalPodAutoscaler
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      maxReplicas: 4
      metrics:
        - containerResource:
            container: chart-base
            name: cpu
            target:
              averageUtilization: 80
              type: Utilization
          type: ContainerResource
        - containerResource:
            container: chart-base
            name: memory
            target:
              averageUtilization: 80
              type: Utilization
          type: ContainerResource
      minReplicas: 2
      scaleTargetRef:
        apiVersion: apps/v1
        kind: Deployment
        name: vending-chart-base
  6: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: HTTPRoute
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      hostnames:
        - sales.example.com
      parentRefs:
        - name: platform-gw
          namespace: gateway
          sectionName: https
      rules:
        - backendRefs:
            - name: vending-chart-base
              port: 80
          matches:
            - path:
                type: PathPrefix
                value: /
  7: |
    apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      ingressClassName: internal
      rules:
        - host: sales.internal.example.com
          http:
            paths:
              - backend:
                  service:
                    name: vending-chart-base
                    port:
                      name: http
                path: /
                pathType: Prefix
  8: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      egress:
        - ports:
            - port: 53
              protocol: UDP
            - port: 53
              protocol: TCP
          to:
            - namespaceSelector:
                matchExpressions:
                  - key: kubernetes.io/metadata.name
                    operator: In
                    values:
                      - kube-system
              podSelector:
                matchLabels:
                  k8s-app: kube-dns
            - ipBlock:
                cidr: 169.254.20.10/32
        - to:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/instance: vending
                  app.kubernetes.io/name: payments
        - ports:
            - port: 5432
              protocol: TCP
            - endPort: 8100
              port: 8000
              protocol: TCP
          to:
            - ipBlock:
                cidr: 192.0.2.0/24
                except:
                  - 192.0.2.128/25
        - ports:
            - port: 9092
              protocol: TCP
          to:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: kafka
              podSelector:
                matchExpressions:
                  - key: strimzi.io/kind
                    operator: In
                    values:
                      - Kafka
      ingress:
        - from:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/instance: vending
                  app.kubernetes.io/name: web
          ports:
            - port: http
              protocol: TCP
        - from:
            - namespaceSelector:
                matchExpressions:
                  - key: kubernetes.io/metadata.name
                    operator: In
                    values:
                      - envoy-gateway-system
                      - ingress-nginx
          ports:
            - port: http
              protocol: TCP
        - from:
            - namespaceSelector:
                matchExpressions:
                  - key: kubernetes.io/metadata.name
                    operator: In
                    values:
                      - monitoring
          ports:
            - port: http
              protocol: TCP
        - from:
            - ipBlock:
                cidr: 10.0.0.0/8
                except:
                  - 10.1.0.0/16
          ports:
            - port: http
      podSelector:
        matchLabels:
          app.kubernetes.io/instance: vending
          app.kubernetes.io/name: chart-base
      policyTypes:
        - Ingress
        - Egress
  9: |
    apiVersion: policy/v1
    kind: PodDisruptionBudget
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      maxUnavailable: 1
      selector:
        matchLabels:
