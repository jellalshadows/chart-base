          targetPort: http
      selector:
        app.kubernetes.io/instance: vending
        app.kubernetes.io/name: chart-base
      type: ClusterIP
  5: |
    apiVersion: v1
    automountServiceAccountToken: false
    kind: ServiceAccount
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
