            - labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: vending
                  app.kubernetes.io/name: chart-base
              matchLabelKeys:
                - pod-template-hash
              maxSkew: 1
              topologyKey: kubernetes.io/hostname
              whenUnsatisfiable: ScheduleAnyway
          volumes:
            - emptyDir: {}
              name: tmp
            - configMap:
                name: vending-chart-base-files
              name: config-files
  4: |
    apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
