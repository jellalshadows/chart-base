cronjob scenario:
  1: |
    apiVersion: v1
    data:
      APP_MODE: cleanup
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: cronjob
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-env
  2: |
    apiVersion: batch/v1
    kind: CronJob
    metadata:
      labels:
        app.kubernetes.io/component: cronjob
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      concurrencyPolicy: Forbid
      failedJobsHistoryLimit: 1
      jobTemplate:
        metadata:
          labels:
            app.kubernetes.io/component: cronjob
            app.kubernetes.io/instance: vending
            app.kubernetes.io/name: chart-base
            app.kubernetes.io/part-of: vending
            app.kubernetes.io/version: 2.66.1
        spec:
          backoffLimit: 3
          template:
            metadata:
              labels:
                app.kubernetes.io/component: cronjob
                app.kubernetes.io/instance: vending
                app.kubernetes.io/name: chart-base
                app.kubernetes.io/part-of: vending
                app.kubernetes.io/version: 2.66.1
            spec:
              automountServiceAccountToken: false
              containers:
                - command:
                    - sh
                    - -c
                    - test "$APP_MODE" = cleanup && echo ok
                  envFrom:
                    - configMapRef:
                        name: vending-chart-base-env
                  image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
                  imagePullPolicy: IfNotPresent
                  name: chart-base
                  resources:
                    requests:
                      cpu: 10m
                      memory: 16Mi
                  securityContext:
                    allowPrivilegeEscalation: false
                    capabilities:
                      drop:
                        - ALL
                    readOnlyRootFilesystem: true
                    runAsNonRoot: true
                  volumeMounts:
                    - mountPath: /tmp
                      name: tmp
              restartPolicy: Never
              securityContext:
                fsGroup: 65532
                fsGroupChangePolicy: OnRootMismatch
                runAsGroup: 65532
                runAsNonRoot: true
                runAsUser: 65532
                seccompProfile:
                  type: RuntimeDefault
              serviceAccountName: vending-chart-base
              terminationGracePeriodSeconds: 30
              volumes:
                - emptyDir: {}
                  name: tmp
          ttlSecondsAfterFinished: 3600
      schedule: '*/30 * * * *'
      successfulJobsHistoryLimit: 3
      timeZone: Europe/Madrid
  3: |
    apiVersion: v1
    automountServiceAccountToken: false
    kind: ServiceAccount
    metadata:
      labels:
        app.kubernetes.io/component: cronjob
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
deployment scenario:
  1: |
    apiVersion: v1
    data:
      APP_MODE: api
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-env
  2: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      progressDeadlineSeconds: 240
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: vending
          app.kubernetes.io/name: chart-base
      template:
        metadata:
          annotations:
            checksum/config-env: b9300982a53776f033a037bcb96a0a60c0760a5bea64c28eb8183ed337a0b3f0
          labels:
            app.kubernetes.io/component: deployment
            app.kubernetes.io/instance: vending
            app.kubernetes.io/name: chart-base
            app.kubernetes.io/part-of: vending
            app.kubernetes.io/version: 2.66.1
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - netexec
                - --http-port=8080
              envFrom:
                - configMapRef:
                    name: vending-chart-base-env
              image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
              imagePullPolicy: IfNotPresent
              lifecycle:
                preStop:
                  sleep:
                    seconds: 5
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: http
              name: chart-base
              ports:
                - containerPort: 8080
                  name: http
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /healthz
                  port: http
              resources:
                limits:
                  memory: 64Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
          securityContext:
            fsGroup: 65532
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 65532
            runAsNonRoot: true
            runAsUser: 65532
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: vending-chart-base
          terminationGracePeriodSeconds: 30
          topologySpreadConstraints:
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: vending
                  app.kubernetes.io/name: chart-base
              matchLabelKeys:
                - pod-template-hash
              maxSkew: 1
              topologyKey: topology.kubernetes.io/zone
              whenUnsatisfiable: ScheduleAnyway
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: vending
                  app.kubernetes.io/name: chart-base
              matchLabelKeys:
                - pod-template-hash
              maxSkew: 1
              topologyKey: kubernetes.io/hostname
              whenUnsatisfiable: ScheduleAnyway
          volumes:
            - emptyDir: {}
              name: tmp
  3: |
    apiVersion: policy/v1
    kind: PodDisruptionBudget
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      maxUnavailable: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: vending
          app.kubernetes.io/name: chart-base
      unhealthyPodEvictionPolicy: AlwaysAllow
  4: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      ports:
