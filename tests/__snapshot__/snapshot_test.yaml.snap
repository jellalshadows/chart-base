        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      progressDeadlineSeconds: 240
      selector:
        matchLabels:
          app.kubernetes.io/instance: vending
          app.kubernetes.io/name: chart-base
      template:
        metadata:
          annotations:
            checksum/config-env: 8e47ec23cd5fb506cde9b5ec7a2ac3f1fb3c7dd7d464fa5dacc8c0236040b339
            checksum/config-files: 6eca5e3945f60573dd6fe5826633f0ae80c3b9a70b80e7951dd26a15f0ec458c
            example.com/team: vending
          labels:
            app.kubernetes.io/component: deployment
            app.kubernetes.io/instance: vending
            app.kubernetes.io/name: chart-base
            app.kubernetes.io/part-of: vending
            app.kubernetes.io/version: 2.66.1
            example.com/tier: backend
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - netexec
                - --http-port=8080
              envFrom:
                - configMapRef:
                    name: vending-chart-base-env
                - secretRef:
                    name: vending-chart-base-secrets
              image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
              imagePullPolicy: IfNotPresent
              lifecycle:
                preStop:
                  sleep:
                    seconds: 5
              name: chart-base
              ports:
                - containerPort: 8080
                  name: http
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /healthz
                  port: http
              resources:
                limits:
                  memory: 64Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
              startupProbe:
                failureThreshold: 30
                httpGet:
                  path: /healthz
                  port: http
                periodSeconds: 2
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /config
                  name: config-files
                  readOnly: true
          securityContext:
            fsGroup: 65532
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 65532
            runAsNonRoot: true
            runAsUser: 65532
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: vending-chart-base
