      name: vending-chart-base-env
  2: |
    apiVersion: v1
    data:
      application.yaml: |-
        spring:
          datasource:
            password: ${DB_PASSWORD}
            url: jdbc:postgresql://db:5432/sales
      logback-spring.xml: |
        <configuration>
          <root level="INFO"/>
        </configuration>
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
