        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      hostnames:
        - sales.example.com
      parentRefs:
        - name: platform-gw
          namespace: gateway
          sectionName: https
      rules:
        - backendRefs:
            - name: vending-chart-base
              port: 80
          matches:
