cronjob scenario:
  1: |
    apiVersion: v1
    data:
      APP_MODE: cleanup
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: cronjob
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-env
  2: |
    apiVersion: batch/v1
    kind: CronJob
    metadata:
      labels:
        app.kubernetes.io/component: cronjob
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      concurrencyPolicy: Forbid
      failedJobsHistoryLimit: 1
      jobTemplate:
        metadata:
          labels:
            app.kubernetes.io/component: cronjob
            app.kubernetes.io/instance: vending
            app.kubernetes.io/name: chart-base
            app.kubernetes.io/part-of: vending
            app.kubernetes.io/version: 2.66.1
        spec:
          backoffLimit: 3
          template:
            metadata:
              labels:
                app.kubernetes.io/component: cronjob
                app.kubernetes.io/instance: vending
                app.kubernetes.io/name: chart-base
                app.kubernetes.io/part-of: vending
                app.kubernetes.io/version: 2.66.1
            spec:
              automountServiceAccountToken: false
              containers:
                - command:
                    - sh
                    - -c
                    - test "$APP_MODE" = cleanup && test -n "$POD_NAME" && test "$MEMORY_MB" = 64 && test "$SHARED_TOKEN" = abc && echo ok
                  env:
                    - name: MEMORY_MB
                      valueFrom:
                        resourceFieldRef:
                          divisor: 1Mi
                          resource: limits.memory
                    - name: POD_NAME
                      valueFrom:
                        fieldRef:
                          fieldPath: metadata.name
                  envFrom:
                    - prefix: SHARED_
                      secretRef:
                        name: e2e-shared
                    - configMapRef:
                        name: vending-chart-base-env
                  image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
                  imagePullPolicy: IfNotPresent
                  name: chart-base
                  resources:
                    limits:
                      memory: 64Mi
                    requests:
                      cpu: 10m
                      memory: 16Mi
                  securityContext:
                    allowPrivilegeEscalation: false
                    capabilities:
                      drop:
                        - ALL
                    readOnlyRootFilesystem: true
                    runAsNonRoot: true
                  volumeMounts:
                    - mountPath: /tmp
                      name: tmp
              enableServiceLinks: false
              restartPolicy: Never
              securityContext:
                fsGroup: 65532
                fsGroupChangePolicy: OnRootMismatch
                runAsGroup: 65532
                runAsNonRoot: true
                runAsUser: 65532
                seccompProfile:
                  type: RuntimeDefault
              serviceAccountName: vending-chart-base
              terminationGracePeriodSeconds: 30
              volumes:
                - emptyDir: {}
                  name: tmp
      schedule: '*/30 * * * *'
      successfulJobsHistoryLimit: 3
      suspend: false
      timeZone: Europe/Madrid
  3: |
    apiVersion: v1
    automountServiceAccountToken: false
    kind: ServiceAccount
    metadata:
      labels:
        app.kubernetes.io/component: cronjob
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
deployment scenario:
  1: |
    apiVersion: v1
    data:
      APP_MODE: api
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-env
  2: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      progressDeadlineSeconds: 240
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: vending
          app.kubernetes.io/name: chart-base
      template:
        metadata:
          annotations:
            checksum/config-env: 75b7a7c324b7b1ceeee7b8e259bbac68dc693ec9adf80945c927b2a1116c4ebb
          labels:
            app.kubernetes.io/component: deployment
            app.kubernetes.io/instance: vending
            app.kubernetes.io/name: chart-base
            app.kubernetes.io/part-of: vending
            app.kubernetes.io/version: 2.66.1
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - netexec
                - --http-port=8080
              envFrom:
                - configMapRef:
                    name: vending-chart-base-env
              image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
              imagePullPolicy: IfNotPresent
              lifecycle:
                preStop:
                  sleep:
                    seconds: 5
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: http
              name: chart-base
              ports:
                - containerPort: 8080
                  name: http
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /healthz
                  port: http
              resources:
                limits:
                  memory: 64Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
          enableServiceLinks: false
          securityContext:
            fsGroup: 65532
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 65532
            runAsNonRoot: true
            runAsUser: 65532
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: vending-chart-base
          terminationGracePeriodSeconds: 30
          topologySpreadConstraints:
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: vending
                  app.kubernetes.io/name: chart-base
              matchLabelKeys:
                - pod-template-hash
              maxSkew: 1
              topologyKey: topology.kubernetes.io/zone
              whenUnsatisfiable: ScheduleAnyway
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: vending
                  app.kubernetes.io/name: chart-base
              matchLabelKeys:
                - pod-template-hash
              maxSkew: 1
              topologyKey: kubernetes.io/hostname
              whenUnsatisfiable: ScheduleAnyway
          volumes:
            - emptyDir: {}
              name: tmp
  3: |
    apiVersion: policy/v1
    kind: PodDisruptionBudget
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      maxUnavailable: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: vending
          app.kubernetes.io/name: chart-base
      unhealthyPodEvictionPolicy: AlwaysAllow
  4: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      ports:
        - name: http
          port: 8080
          protocol: TCP
          targetPort: http
      selector:
        app.kubernetes.io/instance: vending
        app.kubernetes.io/name: chart-base
      type: ClusterIP
  5: |
    apiVersion: v1
    automountServiceAccountToken: false
    kind: ServiceAccount
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
full scenario:
  1: |
    apiVersion: v1
    data:
      APP_MODE: api
      FEATURE_FLAG: "true"
      MAX_POOL: "20"
      SPRING_CONFIG_ADDITIONAL_LOCATION: optional:file:/config/
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-env
  2: |
    apiVersion: v1
    data:
      application.yaml: |-
        spring:
          datasource:
            password: ${DB_PASSWORD}
            url: jdbc:postgresql://db:5432/sales
      logback-spring.xml: |
        <configuration>
          <root level="INFO"/>
        </configuration>
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-files
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      annotations:
        secret.reloader.stakater.com/reload: e2e-shared,vending-chart-base-secrets
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      progressDeadlineSeconds: 240
      selector:
        matchLabels:
          app.kubernetes.io/instance: vending
          app.kubernetes.io/name: chart-base
      template:
        metadata:
          annotations:
            checksum/config-env: 5bb45ae36a56ebe7a1525d036a5ba7c400189b0dcd20fed1f777f87e5282fc14
            checksum/config-files: 2f54280aa10f85462610e938e4985cf3194df1c9ffb8ffaea4b1c70fa074f796
            example.com/team: vending
          labels:
            app.kubernetes.io/component: deployment
            app.kubernetes.io/instance: vending
            app.kubernetes.io/name: chart-base
            app.kubernetes.io/part-of: vending
            app.kubernetes.io/version: 2.66.1
            example.com/tier: backend
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - netexec
                - --http-port=8080
              env:
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: SHARED_TOKEN
                  valueFrom:
                    secretKeyRef:
                      key: TOKEN
                      name: e2e-shared
              envFrom:
                - configMapRef:
                    name: vending-chart-base-env
                - secretRef:
                    name: vending-chart-base-secrets
              image: registry.k8s.io/e2e-test-images/agnhost:2.66.1
              imagePullPolicy: IfNotPresent
              lifecycle:
                preStop:
                  sleep:
                    seconds: 5
              name: chart-base
              ports:
                - containerPort: 8080
                  name: http
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /healthz
                  port: http
              resources:
                limits:
                  memory: 64Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
              startupProbe:
                failureThreshold: 30
                httpGet:
                  path: /healthz
                  port: http
                periodSeconds: 2
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /config
                  name: config-files
                  readOnly: true
          enableServiceLinks: false
          securityContext:
            fsGroup: 65532
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 65532
            runAsNonRoot: true
            runAsUser: 65532
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: vending-chart-base
          terminationGracePeriodSeconds: 30
          topologySpreadConstraints:
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: vending
                  app.kubernetes.io/name: chart-base
              matchLabelKeys:
                - pod-template-hash
              maxSkew: 1
              topologyKey: topology.kubernetes.io/zone
              whenUnsatisfiable: ScheduleAnyway
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: vending
                  app.kubernetes.io/name: chart-base
              matchLabelKeys:
                - pod-template-hash
              maxSkew: 1
              topologyKey: kubernetes.io/hostname
              whenUnsatisfiable: ScheduleAnyway
          volumes:
            - emptyDir: {}
              name: tmp
            - configMap:
                name: vending-chart-base-files
              name: config-files
  4: |
    apiVersion: external-secrets.io/v1
    kind: ExternalSecret
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base-secrets
    spec:
      data:
        - remoteRef:
            key: /sales/db-password
          secretKey: DB_PASSWORD
      refreshInterval: 1h
      secretStoreRef:
        kind: ClusterSecretStore
        name: fake
      target:
        creationPolicy: Owner
        name: vending-chart-base-secrets
  5: |
    apiVersion: autoscaling/v2
    kind: HorizontalPodAutoscaler
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      maxReplicas: 4
      metrics:
        - resource:
            name: cpu
            target:
              averageUtilization: 80
              type: Utilization
          type: Resource
        - resource:
            name: memory
            target:
              averageUtilization: 80
              type: Utilization
          type: Resource
      minReplicas: 2
      scaleTargetRef:
        apiVersion: apps/v1
        kind: Deployment
        name: vending-chart-base
  6: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: HTTPRoute
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      hostnames:
        - sales.example.com
      parentRefs:
        - name: platform-gw
          namespace: gateway
          sectionName: https
      rules:
        - backendRefs:
            - name: vending-chart-base
              port: 80
          matches:
            - path:
                type: PathPrefix
                value: /
  7: |
    apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      ingressClassName: internal
      rules:
        - host: sales.internal.example.com
          http:
            paths:
              - backend:
                  service:
                    name: vending-chart-base
                    port:
                      name: http
                path: /
                pathType: Prefix
  8: |
    apiVersion: policy/v1
    kind: PodDisruptionBudget
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      maxUnavailable: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: vending
          app.kubernetes.io/name: chart-base
      unhealthyPodEvictionPolicy: AlwaysAllow
  9: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: chart-base
        app.kubernetes.io/part-of: vending
        app.kubernetes.io/version: 2.66.1
        helm.sh/chart: chart-base-0.0.0-test
      name: vending-chart-base
    spec:
      ports:
        - name: http
          port: 80
          protocol: TCP
          targetPort: http
      selector:
        app.kubernetes.io/instance: vending
        app.kubernetes.io/name: chart-base
      type: ClusterIP
  10: |
    apiVersion: v1
    automountServiceAccountToken: false
    kind: ServiceAccount
    metadata:
      annotations:
        iam.gke.io/gcp-service-account: sales@acme.iam.gserviceaccount.com
      labels:
        app.kubernetes.io/component: deployment
        app.kubernetes.io/instance: vending
        app.kubernetes.io/managed-by: Helm
