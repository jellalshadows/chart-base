{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "chart-base values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workload",
    "image",
    "resources",
    "serviceAccount",
    "rbac",
    "job",
    "cronjob",
    "autoscaling",
    "pdb",
    "service",
    "configFiles",
    "externalSecret",
    "reloadOnChange",
    "probes",
    "podSecurityContext",
    "securityContext",
    "replicas",
    "progressDeadlineSeconds",
    "preStopSleepSeconds",
    "terminationGracePeriodSeconds",
    "enableServiceLinks",
    "metrics",
    "prometheusRule",
    "networkPolicy"
  ],
  "definitions": {
    "keyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" }
      }
    },
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" }
      }
    },
    "intOrPercent": {
      "type": ["integer", "string"],
      "minimum": 0,
      "pattern": "^[0-9]+%$"
    },
    "lifecycleHandler": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["exec"] },
        { "required": ["httpGet"] },
        { "required": ["sleep"] }
      ],
      "properties": {
        "exec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "httpGet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "path": { "type": "string" },
            "port": { "type": ["integer", "string"] },
            "scheme": { "enum": ["HTTP", "HTTPS"] },
            "httpHeaders": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "value"],
                "properties": {
                  "name": { "type": "string" },
                  "value": { "type": "string" }
                }
              }
            }
          }
        },
        "sleep": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seconds"],
          "properties": {
            "seconds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "duration": {
      "description": "A Prometheus duration, with the pattern of the prometheus-operator CRDs (v0.94.1), e.g. 30s, 1m30s, 1h.",
      "type": "string",
      "pattern": "^(0|(([0-9]+)y)?(([0-9]+)w)?(([0-9]+)d)?(([0-9]+)h)?(([0-9]+)m)?(([0-9]+)s)?(([0-9]+)ms)?)$"
    },
    "extraLabels": {
      "description": "Extra labels of an object that also carries the chart's labels: the keys the chart sets itself are rejected (they would render twice).",
      "type": "object",
      "propertyNames": { "not": { "enum": ["app.kubernetes.io/name", "app.kubernetes.io/instance", "app.kubernetes.io/part-of", "app.kubernetes.io/component", "app.kubernetes.io/version", "app.kubernetes.io/managed-by", "helm.sh/chart"] } },
      "additionalProperties": { "type": "string" }
    },
    "nonEmptyDuration": {
      "description": "A Prometheus duration that is not empty (the CRDs' NonEmptyDuration): the operator writes an empty for or group interval to Prometheus, whose duration parser rejects it.",
      "allOf": [{ "$ref": "#/definitions/duration" }],
      "minLength": 1
    },
    "networkPolicyAlias": {
      "description": "The alias of a sibling component of the same release: the chart's alias rule (templates/validate.yaml), at most 63 characters (a label value).",
      "type": "string",
      "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "namespaceName": {
      "description": "A namespace name: a DNS-1123 label.",
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "cidr": {
      "description": "An IPv4 or IPv6 CIDR, e.g. 10.0.0.0/8 or fd00::/8. Only the shape is checked: the API server checks the rest, e.g. that an except is a strict subset of its cidr.",
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])([.](25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}/(3[0-2]|[12]?[0-9])|(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){0,6}[0-9a-fA-F]{0,4}::([0-9a-fA-F]{1,4}:){0,6}[0-9a-fA-F]{0,4})/(12[0-8]|1[01][0-9]|[1-9]?[0-9]))$"
    },
    "networkPolicyPort": {
      "description": "A NetworkPolicyPort: a port number or a container port name (resolved on the selected or the destination pod), a protocol (TCP by default) and, with a port number, an endPort. The port is required: an entry without one reads as nothing and means every port of the protocol (a whole protocol is port 1 with endPort 65535).",
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string", "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$", "maxLength": 15 }
          ]
        },
        "endPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "enum": ["TCP", "UDP", "SCTP"] }
      },
      "dependencies": {
        "endPort": { "required": ["port"], "properties": { "port": { "type": "integer" } } }
      }
    },
    "labelSelector": {
      "description": "A label selector. {} selects every pod or namespace; a matchLabels or matchExpressions that is present must not be empty.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
        "matchExpressions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "operator"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "operator": { "enum": ["In", "NotIn", "Exists", "DoesNotExist"] },
              "values": { "type": "array", "items": { "type": "string" } }
            },
            "if": { "properties": { "operator": { "enum": ["In", "NotIn"] } } },
            "then": { "required": ["values"], "properties": { "values": { "minItems": 1 } } },
            "else": { "properties": { "values": { "maxItems": 0 } } }
          }
        }
      }
    },
    "networkPolicyPeer": {
      "description": "A NetworkPolicyPeer: a podSelector and/or a namespaceSelector (both in one peer: the selected pods of the selected namespaces), or an ipBlock alone.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "podSelector": { "$ref": "#/definitions/labelSelector" },
        "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidr"],
          "properties": {
            "cidr": { "$ref": "#/definitions/cidr" },
            "except": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/cidr" } }
          }
        }
      },
      "if": { "required": ["ipBlock"] },
      "then": { "maxProperties": 1 }
    },
    "networkPolicyIngressRule": {
      "description": "A NetworkPolicyIngressRule. An omitted from or ports means every source or port; an empty list, which means the same in the API, is rejected.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/networkPolicyPeer" } },
        "ports": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/networkPolicyPort" } }
      }
    },
    "numericPort": {
      "description": "A port of a destination outside the cluster, by number (a CIDR has no named ports): port, an optional endPort and a protocol (TCP by default).",
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "endPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "enum": ["TCP", "UDP", "SCTP"] }
      }
    },
    "networkPolicyEgressRule": {
      "description": "A NetworkPolicyEgressRule. An omitted to or ports means every destination or port; an empty list, which means the same in the API, is rejected.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/networkPolicyPeer" } },
        "ports": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/networkPolicyPort" } }
      }
    },
    "rbacName": {
      "description": "The name of a Role or a ClusterRole: a path segment name (ValidateRBACName), not . or .., without / or %; and no *, which a roleRef reads as a name, not as a wildcard.",
      "type": "string",
      "pattern": "^[^/%*]+$",
      "not": { "enum": [".", ".."] }
    },
    "policyRule": {
      "description": "A namespaced PolicyRule as the API server validates it (ValidatePolicyRule), and stricter: no nonResourceURLs (a namespaced rule cannot apply to them), verbs, apiGroups and resources required and not empty, resourceNames not empty when present, no * anywhere (a wildcard grants future resources and verbs; in resourceNames it is no wildcard and matches no object) and the standard verbs only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["apiGroups", "resources", "verbs"],
      "properties": {
        "apiGroups": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[^*]*$" } },
        "resources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[^*]+$" } },
        "resourceNames": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[^*]+$" } },
        "verbs": { "type": "array", "minItems": 1, "items": { "enum": ["get", "list", "watch", "create", "update", "patch", "delete", "deletecollection", "use", "bind", "escalate", "impersonate"] } }
      }
    },
    "httpRouteParentRef": {
      "description": "An HTTPRoute parentRef: exactly the fields of ParentReference in the Gateway API v1.6.2 Standard CRD, its required name and its port range. The API server drops an unknown field, so a misspelt sectionName would attach the route to every listener of the Gateway.",
      "type": "object",
      "additionalProperties": false, "required": ["name"],
      "properties": {
        "group": { "type": "string" },
        "kind": { "type": "string" },
        "namespace": { "type": "string" },
        "name": { "type": "string" },
        "sectionName": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "httpRouteMatch": {
      "description": "An HTTPRoute match: exactly the fields of HTTPRouteMatch in the Gateway API v1.6.2 Standard CRD, at every level, with its enums and required fields. The API server drops an unknown field, so a misspelt path would match every request.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "path": { "type": "object", "additionalProperties": false, "properties": { "type": { "enum": ["Exact", "PathPrefix", "RegularExpression"] }, "value": { "type": "string" } } },
        "headers": { "type": "array", "items": { "$ref": "#/definitions/httpRouteValueMatch" } },
        "queryParams": { "type": "array", "items": { "$ref": "#/definitions/httpRouteValueMatch" } },
        "method": { "enum": ["GET", "HEAD", "POST", "PUT", "DELETE", "CONNECT", "OPTIONS", "TRACE", "PATCH"] }
      }
    },
    "httpRouteValueMatch": {
      "description": "A header or query parameter match of an HTTPRoute (HTTPHeaderMatch and HTTPQueryParamMatch of the Gateway API v1.6.2 Standard CRD): name and value required, type Exact or RegularExpression.",
      "type": "object",
      "additionalProperties": false, "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "type": { "enum": ["Exact", "RegularExpression"] },
        "value": { "type": "string" }
      }
    },
    "fileMode": {
      "description": "A file mode of a mounted ConfigMap or Secret, 0 to 0777 (511): write it in octal with a leading zero, unquoted (0440); 440 is decimal (0670). --set cannot pass an octal literal: use the decimal value (288). null = absent.",
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 511
    },
    "positiveQuantity": {
      "description": "A size: a Kubernetes quantity string without a sign (1Gi, 500Mi, 1e3), or null (absent). A YAML number is rejected (write \"1000000000\" or 1Gi); a size of zero is rejected by templates/validate.yaml.",
      "type": ["string", "null"],
      "pattern": "^([0-9.]+)([eEinumkKMGTP]*[-+]?[0-9]*)$"
    },
    "volumeItems": {
      "description": "Keys of the ConfigMap or Secret to mount, each at a relative path: absent or null = every key; [] is rejected (the API reads an empty list as every key). A list: an overlay replaces it whole, and a null item or mode is rejected.",
      "type": ["array", "null"], "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["key", "path"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "mode": { "allOf": [{ "$ref": "#/definitions/fileMode" }], "type": "integer" }
        }
      }
    },
    "volume": {
      "description": "An entry of volumes: one pod volume and its mount in the main container. null = no entry; every optional field also accepts null (absent). One closed list of the fields of every type: a field of another type is rejected by templates/validate.yaml, so that an overlay can change the type by setting the previous type's fields to null.",
      "type": ["object", "null"], "additionalProperties": false, "required": ["type", "mountPath"],
      "properties": {
        "type": { "enum": ["emptyDir", "configMap", "secret", "persistentVolumeClaim", "ephemeral"] },
        "mountPath": { "type": "string", "pattern": "^/", "description": "Absolute: the kubelet would resolve a relative path against /." },
        "subPath": { "type": ["string", "null"], "minLength": 1 },
        "readOnly": { "type": ["boolean", "null"] },
        "medium": { "enum": ["Memory", null] },
        "sizeLimit": { "$ref": "#/definitions/positiveQuantity" },
        "name": { "type": ["string", "null"], "minLength": 1 },
        "secretName": { "type": ["string", "null"], "minLength": 1 },
        "items": { "$ref": "#/definitions/volumeItems" },
        "defaultMode": { "$ref": "#/definitions/fileMode" },
        "optional": { "type": ["boolean", "null"] },
        "claimName": { "type": ["string", "null"], "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?([.][a-z0-9]([-a-z0-9]*[a-z0-9])?)*$", "maxLength": 253 },
        "claimAccessMode": { "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany", null] },
        "size": { "$ref": "#/definitions/positiveQuantity" },
        "accessMode": { "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", null] },
        "storageClassName": { "type": ["string", "null"], "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?([.][a-z0-9]([-a-z0-9]*[a-z0-9])?)*$", "maxLength": 253 }
      },
      "allOf": [
        { "if": { "required": ["type"], "properties": { "type": { "const": "configMap" } } }, "then": { "required": ["name"] } },
        { "if": { "required": ["type"], "properties": { "type": { "const": "secret" } } }, "then": { "required": ["secretName"] } },
        { "if": { "required": ["type"], "properties": { "type": { "const": "persistentVolumeClaim" } } }, "then": { "required": ["claimName"] } },
        { "if": { "required": ["type"], "properties": { "type": { "const": "ephemeral" } } }, "then": { "required": ["size"] } }
      ]
    },
    "resources": {
      "description": "Container resources, of the main container and of every init container and sidecar: requests.cpu and requests.memory required (ADR-0014); a null limit or request other than those two is absent, and limits: null is no limit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["requests"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": ["string", "number"] }
          }
        },
        "limits": { "type": ["object", "null"] }
      }
    },
    "containerImage": {
      "description": "The image of an init container or a sidecar: repository, and a tag or a digest (the digest wins); pullPolicy, default IfNotPresent (an entry has no chart default). Each anyOf branch types its field, so that a null tag is no tag.",
      "type": "object", "additionalProperties": false, "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": ["string", "null"] },
        "digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never", null] }
      },
      "anyOf": [
        { "required": ["tag"], "properties": { "tag": { "type": "string", "minLength": 1 } } },
        { "required": ["digest"], "properties": { "digest": { "type": "string", "minLength": 1 } } }
      ]
    },
    "containerArgs": {
      "description": "command or args of an init container or a sidecar: a list of strings rendered as written (an overlay replaces a list whole); null or [] renders nothing.",
      "type": ["array", "null"], "items": { "type": "string" }
    },
    "containerOrder": {
      "description": "The start order of an init container or a sidecar, -1000 to 1000; null = the default (0 for an init container, 1000 for a sidecar). templates/_containers.tpl sorts on order + 1000 as text, an offset equal to minus this minimum: change both together.",
      "type": ["integer", "null"],
      "minimum": -1000,
      "maximum": 1000
    },
    "initContainer": {
      "description": "An entry of initContainers: a container that runs to completion before the next one starts. Closed at every level the chart defines; every optional field also accepts null (absent).",
      "type": "object", "required": ["image", "resources"], "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/containerImage" },
        "resources": { "$ref": "#/definitions/resources" },
        "command": { "$ref": "#/definitions/containerArgs" },
        "args": { "$ref": "#/definitions/containerArgs" },
        "securityContext": { "type": ["object", "null"], "description": "Merged over the chart's hardened default, field by field; null restores the default of a field." },
        "restartPolicy": { "description": "Written by the chart, never a value: templates/validate.yaml rejects the key with a remedy (null is absent)." },
        "order": { "description": "An init container's default is 0.", "$ref": "#/definitions/containerOrder" }
      }
    },
    "sidecar": {
      "description": "An entry of sidecars: a container that keeps running next to the main container (an init container with restartPolicy: Always, written by the chart). Closed at every level the chart defines; every optional field also accepts null (absent).",
      "type": "object", "additionalProperties": false, "required": ["image", "resources"],
      "properties": {
        "image": { "$ref": "#/definitions/containerImage" },
        "resources": { "$ref": "#/definitions/resources" },
        "command": { "$ref": "#/definitions/containerArgs" },
        "args": { "$ref": "#/definitions/containerArgs" },
        "securityContext": { "type": ["object", "null"], "description": "Merged over the chart's hardened default, field by field; null restores the default of a field." },
        "restartPolicy": { "description": "Written by the chart, never a value: templates/validate.yaml rejects the key with a remedy (null is absent)." },
        "order": { "description": "A sidecar's default is 1000.", "$ref": "#/definitions/containerOrder" }
      }
    }
  },
  "properties": {
    "global": { "type": "object", "description": "Injected by Helm into every alias. Ignored by chart-base." },
    "enabled": { "type": "boolean", "description": "Used by umbrellas as `condition: <alias>.enabled`." },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["deployment", "cronjob", "job"] }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "anyOf": [
        { "required": ["tag"], "properties": { "tag": { "minLength": 1 } } },
        { "required": ["digest"], "properties": { "digest": { "minLength": 1 } } }
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "command": { "type": "array", "items": { "type": "string" } },
    "args": { "type": "array", "items": { "type": "string" } },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "containerPort"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$", "maxLength": 15 },
          "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "servicePort": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      }
    },
    "resources": { "$ref": "#/definitions/resources" },
    "config": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "configFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mountPath"],
      "properties": {
        "mountPath": { "type": "string", "pattern": "^/" },
        "files": {
          "type": "object",
          "propertyNames": { "pattern": "^[-._a-zA-Z0-9]+$" },
          "additionalProperties": { "type": ["string", "object", "null"] }
        }
      }
    },
    "volumes": {
      "description": "Extra volumes mounted in the main container, keyed by the volume name (templates/validate.yaml checks the name). null = none; a null entry or field is absent.",
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/volume" }
    },
    "initContainers": {
      "description": "Init containers, keyed by the container name (templates/validate.yaml checks the name, and rejects a list with the map form). null = none; a null entry or field is absent.",
      "type": ["object", "array"],
      "additionalProperties": { "type": ["object", "null"], "if": { "type": "object" }, "then": { "$ref": "#/definitions/initContainer" } }
    },
    "sidecars": {
      "description": "Sidecars, keyed by the container name (templates/validate.yaml checks the name, and rejects a list with the map form). null = none; a null entry or field is absent.",
      "type": ["object", "array"],
      "additionalProperties": { "type": ["object", "null"], "if": { "type": "object" }, "then": { "$ref": "#/definitions/sidecar" } }
    },
    "externalSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "refreshInterval", "secretStoreRef"],
      "properties": {
        "enabled": { "type": "boolean" },
        "secretStoreRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["ClusterSecretStore", "SecretStore"] },
            "name": { "type": "string" }
          }
        },
        "refreshInterval": { "type": "string" },
        "data": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "property": { "type": "string" }
            }
          }
        }
      }
    },
    "reloadOnChange": { "type": "boolean" },
    "env": {
      "type": ["object", "array"],
      "description": "References only: literal values belong in `config`.",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": {
        "type": ["object", "string", "number", "boolean"],
        "additionalProperties": false,
        "required": ["valueFrom"],
        "properties": {
          "valueFrom": {
            "type": "object",
            "additionalProperties": false,
            "oneOf": [
              { "required": ["fieldRef"] },
              { "required": ["resourceFieldRef"] },
              { "required": ["secretKeyRef"] },
              { "required": ["configMapKeyRef"] }
            ],
            "properties": {
              "fieldRef": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fieldPath"],
                "properties": {
                  "fieldPath": { "type": "string", "minLength": 1 },
                  "apiVersion": { "type": "string" }
                }
              },
              "resourceFieldRef": {
                "type": "object",
                "additionalProperties": false,
                "required": ["resource"],
                "properties": {
                  "resource": { "type": "string", "minLength": 1 },
                  "containerName": { "type": "string" },
                  "divisor": { "type": ["string", "number"] }
                }
              },
              "secretKeyRef": { "$ref": "#/definitions/keyRef" },
              "configMapKeyRef": { "$ref": "#/definitions/keyRef" }
            }
          }
        }
      }
    },
    "envFrom": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          { "required": ["configMapRef"] },
          { "required": ["secretRef"] }
        ],
        "properties": {
          "configMapRef": { "$ref": "#/definitions/objectRef" },
          "secretRef": { "$ref": "#/definitions/objectRef" },
          "prefix": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        }
      }
    },
    "replicas": { "type": "integer", "minimum": 0 },
    "progressDeadlineSeconds": { "type": "integer", "minimum": 1 },
    "strategy": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["RollingUpdate", "Recreate"] },
        "rollingUpdate": {
          "description": "null means absent (never rendered); a rollingUpdate next to Recreate is rejected by templates/validate.yaml.",
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {
            "maxSurge": { "$ref": "#/definitions/intOrPercent" },
            "maxUnavailable": {
              "description": "Kubernetes rejects a percentage above 100% (maxSurge has no such cap).",
              "allOf": [{ "$ref": "#/definitions/intOrPercent" }],
              "pattern": "^0*([0-9]{1,2}|100)%$"
            }
          }
        }
      }
    },
    "minReadySeconds": { "type": ["integer", "null"], "minimum": 0 },
    "revisionHistoryLimit": { "type": ["integer", "null"], "minimum": 0 },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "type"],
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": { "type": "object" },
        "liveness": { "type": "object" },
        "readiness": { "type": "object" }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "unhealthyPodEvictionPolicy"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string", "null"] },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "unhealthyPodEvictionPolicy": { "enum": ["IfHealthyBudget", "AlwaysAllow"] }
      },
      "not": {
        "required": ["minAvailable", "maxUnavailable"],
        "properties": {
          "minAvailable": { "type": ["integer", "string"] },
          "maxUnavailable": { "type": ["integer", "string"] }
        }
      }
    },
    "topologySpreadConstraints": { "type": ["array", "null"], "items": { "type": "object" } },
    "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postStart": { "$ref": "#/definitions/lifecycleHandler" },
        "preStop": { "$ref": "#/definitions/lifecycleHandler" }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": { "type": "array", "items": { "$ref": "#/definitions/httpRouteParentRef" } },
        "hostnames": { "type": "array", "items": { "type": "string" } },
        "matches": { "type": "array", "items": { "$ref": "#/definitions/httpRouteMatch" } }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port", "path"],
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "interval": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/duration" }] },
        "scrapeTimeout": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/duration" }] },
        "labels": { "$ref": "#/definitions/extraLabels" }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "labels": { "$ref": "#/definitions/extraLabels" },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "rules"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "interval": { "$ref": "#/definitions/nonEmptyDuration" },
              "rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["expr"],
                  "if": { "required": ["record"] },
                  "then": { "properties": { "for": false, "keep_firing_for": false, "annotations": false } },
                  "oneOf": [
                    { "required": ["alert"] },
                    { "required": ["record"] }
                  ],
                  "properties": {
                    "alert": { "type": "string", "minLength": 1 },
                    "record": { "type": "string", "minLength": 1 },
                    "expr": { "type": "string", "minLength": 1 },
                    "for": { "$ref": "#/definitions/nonEmptyDuration" },
                    "keep_firing_for": { "$ref": "#/definitions/nonEmptyDuration" },
                    "labels": { "type": "object", "additionalProperties": { "type": "string" } },
                    "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingress", "egress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fromComponents": { "type": "array", "items": { "$ref": "#/definitions/networkPolicyAlias" } },
            "fromNamespaces": { "type": "array", "items": { "$ref": "#/definitions/namespaceName" } },
            "metricsFromNamespaces": { "type": "array", "items": { "$ref": "#/definitions/namespaceName" } },
            "routeTrafficAllowedElsewhere": { "type": "boolean" },
            "extra": { "type": "array", "items": { "$ref": "#/definitions/networkPolicyIngressRule" } }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "dns"],
          "properties": {
            "enabled": { "type": "boolean" },
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "namespace", "ports"],
              "properties": {
                "enabled": { "type": "boolean" },
                "namespace": { "$ref": "#/definitions/namespaceName" },
                "podSelector": {
                  "description": "null: {k8s-app: kube-dns}. A map replaces it (it is not merged with it).",
                  "type": ["object", "null"],
                  "minProperties": 1,
                  "additionalProperties": { "type": "string" }
                },
                "ports": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["port", "protocol"],
                    "properties": {
                      "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                      "protocol": { "enum": ["TCP", "UDP", "SCTP"] }
                    }
                  }
                },
                "cidrs": { "type": "array", "items": { "$ref": "#/definitions/cidr" } }
              }
            },
            "toComponents": { "type": "array", "items": { "$ref": "#/definitions/networkPolicyAlias" } },
            "toCIDRs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cidr"],
                "properties": {
                  "cidr": { "$ref": "#/definitions/cidr" },
                  "except": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/cidr" } },
                  "ports": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/numericPort" } }
                }
              }
            },
            "extra": { "type": "array", "items": { "$ref": "#/definitions/networkPolicyEgressRule" } }
          }
        }
      }
    },
    "cronjob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concurrencyPolicy", "successfulJobsHistoryLimit", "failedJobsHistoryLimit", "suspend"],
      "properties": {
        "schedule": { "type": "string" },
        "timeZone": { "type": "string" },
        "concurrencyPolicy": { "enum": ["Allow", "Forbid", "Replace"] },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "startingDeadlineSeconds": { "type": ["integer", "null"], "minimum": 0 },
        "suspend": { "type": "boolean" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "backoffLimit", "ttlSecondsAfterFinished"],
      "properties": {
        "phase": { "enum": ["pre-deploy", "post-deploy"] },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": ["integer", "null"], "minimum": 1 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "automountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "name": {
          "description": "An existing ServiceAccount, only with create: false: a DNS-1123 subdomain (templates/validate.yaml rejects it with create: true, and rejects default).",
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?([.][a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "maxLength": 253
        },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "automountToken": { "type": "boolean" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": { "type": "array", "items": { "$ref": "#/definitions/policyRule" } },
        "clusterRoles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/rbacName" } }
      }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": {
      "type": "object",
      "propertyNames": { "not": { "enum": ["app.kubernetes.io/name", "app.kubernetes.io/instance"] } },
      "additionalProperties": { "type": "string" }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": ["string", "null"], "minLength": 1 },
    "runtimeClassName": { "type": ["string", "null"], "minLength": 1 },
    "dnsConfig": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "nameservers": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
        "searches": { "type": "array", "maxItems": 32, "items": { "type": "string" } },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "hostAliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ip", "hostnames"],
        "properties": {
          "ip": { "type": "string" },
          "hostnames": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "enableServiceLinks": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "workload": { "properties": { "type": { "const": "cronjob" } } } } },
      "then": { "properties": { "cronjob": { "required": ["schedule"], "properties": { "schedule": { "minLength": 1 } } } } }
    },
    {
      "if": { "properties": { "workload": { "properties": { "type": { "enum": ["cronjob", "job"] } } } } },
      "then": {
        "properties": {
          "httpRoute": { "properties": { "enabled": { "const": false } } },
          "ingress": { "properties": { "enabled": { "const": false } } },
          "autoscaling": { "properties": { "enabled": { "const": false } } },
          "metrics": { "properties": { "enabled": { "const": false } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload": { "properties": { "type": { "const": "deployment" } } },
          "service": { "properties": { "enabled": { "const": true } } }
        }
      },
      "then": { "required": ["ports"], "properties": { "ports": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "externalSecret": { "properties": { "enabled": { "const": true } } } } },
      "then": {
        "properties": {
          "externalSecret": {
            "properties": {
              "secretStoreRef": { "required": ["kind", "name"], "properties": { "name": { "minLength": 1 } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "httpRoute": { "properties": { "enabled": { "const": true } } } } },
      "then": {
        "properties": {
          "httpRoute": { "required": ["parentRefs"], "properties": { "parentRefs": { "minItems": 1 } } },
          "service": { "properties": { "enabled": { "const": true } } }
        }
      }
    },
    {
      "if": { "properties": { "ingress": { "properties": { "enabled": { "const": true } } } } },
      "then": {
        "properties": {
          "ingress": { "required": ["hosts"], "properties": { "className": { "minLength": 1 }, "hosts": { "minItems": 1 } } },
          "service": { "properties": { "enabled": { "const": true } } }
        }
      }
    },
    {
      "if": { "properties": { "prometheusRule": { "properties": { "enabled": { "const": true } } } } },
      "then": {
        "properties": {
          "prometheusRule": { "required": ["groups"], "properties": { "groups": { "minItems": 1 } } }
        }
      }
    }
  ]
}
